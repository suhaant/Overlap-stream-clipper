# Copy to .env and fill in from https://dev.twitch.tv/console/apps
#
# The Client ID is not a secret (Twitch's docs: "Client IDs are considered
# public and can be embedded in a web page's source"). The secret is.
# .env is gitignored. Do not commit it, and do not paste the secret into chat.

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional. A stable salt for hashing chatter ids. If unset, the recorder
# generates one and keeps it at data/chat/.salt. Set it explicitly only if you
# need the same hashes across two machines.
# RECORDER_SALT=
